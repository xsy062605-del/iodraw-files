        <mxCell id="1ZcxaJH_FYxm95sjxFyD-15" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="1ZcxaJH_FYxm95sjxFyD-13">
          <mxGeometry y="240" width="290" height="8" as="geometry" />
        </mxCell>
        <mxCell id="1ZcxaJH_FYxm95sjxFyD-16" value="&lt;div&gt;__init__(self, host, count=4, ...): 初始化配置。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;resolve_host(self): 封装 DNS 解析和打印 &quot;Pinging...&quot; 的逻辑。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;create_socket(self): 封装 Raw Socket 的创建和权限检查。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;build_packet(self, seq_num): 对应原代码中的 create_icmp_packet 调用及 Payload 生成。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;send_and_receive(self): 核心的单次 Ping 逻辑（包含 sendto, recvfrom, 计时, 解析 TTL）。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;print_statistics(self): 最后的统计打印逻辑。&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="1ZcxaJH_FYxm95sjxFyD-13">
